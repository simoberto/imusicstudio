# AI Music Studio - .gitignore

# General
.DS_Store
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.swp
*.swo
.env
.env.*
!.env.example

# Node / JavaScript
node_modules/
dist/
build/
coverage/
.eslintcache
*.tsbuildinfo

# Frontend specific (React Create App)
frontend/node_modules/
frontend/build/
frontend/coverage/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# WebSocket specific (if it has its own node_modules)
websocket/node_modules/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.pytest_cache/
*.egg-info/
*.egg

# Docker
docker-compose.override.yml

# Data, Models, and Docker runtime data - typically not committed
data/
models/
pgdata/
n8n_data/
redis_data/
prometheus_data/
grafana_data/
nginx_cache/
audiocraft_cache/ # From docker-compose.prod.yml
audiocraft_tmp/   # From docker-compose.yml
lmms_cache/       # From docker-compose.prod.yml
lmms_tmp/         # From docker-compose.yml


# Backups
backups/

# IDE / Editor specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Test reports
junit.xml
TESTS-*.xml

# Log files generated by setup/deploy/publish scripts
setup_complete.log
deploy.log
publish.log

# SSL Private Keys - NEVER commit private keys
nginx/ssl/*.key
nginx/ssl/privkey.pem # Production private key

# Sensitive configuration files (if any were not using .env pattern)
# Example: config/private_config.json
